{
  "name": "@convenux/kit",
  "version": "0.1.0",
  "description": "Code the Convenux apps share: i18n, link previews, logo fit and webhook signatures.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Convenux/kit.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "default": "./dist/i18n.js"
    },
    "./catalogs": {
      "types": "./dist/catalogs.d.ts",
      "default": "./dist/catalogs.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./next/client": {
      "types": "./dist/next/client.d.ts",
      "default": "./dist/next/client.js"
    },
    "./next/proxy": {
      "types": "./dist/next/proxy.d.ts",
      "default": "./dist/next/proxy.js"
    },
    "./logo": {
      "types": "./dist/logo.d.ts",
      "default": "./dist/logo.js"
    },
    "./og": {
      "types": "./dist/og.d.ts",
      "default": "./dist/og.js"
    },
    "./signature": {
      "types": "./dist/signature.d.ts",
      "default": "./dist/signature.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node -e \"const fs = require('node:fs'); for (const f of fs.globSync('dist/**/*.d.ts')) fs.writeFileSync(f, fs.readFileSync(f, 'utf8').replace(/(?<=from \\\"\\.{1,2}\\/[^\\\"]+)\\.tsx?(?=\\\")/g, '.js'))\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.6"
  },
  "peerDependencies": {
    "next": ">=16",
    "posthog-js": ">=1",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "posthog-js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "next": "16.3.4",
    "posthog-js": "^1.428.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5"
  }
}
